NUXT_SESSION_PASSWORD=replace-with-at-least-32-characters

# Admin. Unset means the admin cannot be logged into at all.
ADMIN_PASSWORD=replace-with-a-real-password

# Local MySQL container
MYSQL_DATABASE=iut_onboarding
MYSQL_USER=onboarding
MYSQL_PASSWORD=onboarding
MYSQL_ROOT_PASSWORD=onboarding_root
MYSQL_PORT=3306
DATABASE_URL=mysql://onboarding:onboarding@127.0.0.1:3306/iut_onboarding

MEME_API_URL=https://meme-api.com/gimme
DAILY_MEME_TIMEZONE=Europe/Paris
